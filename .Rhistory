# Load packages
library(sf)               # classes and functions for vector data
library(tmap)             # classes and functions for thematic mapping
library(spData)           # data for assignment
library(dplyr)            # needed for joining tables
# look at spData world sf
names(world)
head(world)
st_crs(world)
# look at the world data
plot(world)
# transform the world data to the robinson CRS
world_rob <- st_transform(world, crs= "ESRI:53030")
# look at spData for world_df
head(worldbank_df)
names(worldbank_df)
# join the tables
world_rob_join <- left_join(world_rob, worldbank_df)
# look at the field names
names(world_rob_join)
# plot the data
plot(world_rob_join)
########################################
## part 1 make a map of population growth
# Map population growth
popgrowth_map <- tm_shape(world_rob_join) +
tm_fill("pop_growth", palette = "Reds", style='quantile', n=5, alpha = 0.75, title='pop_growth') +
tm_borders(col='grey',lwd = 1)+
tm_layout(main.title = "World Population Growth", frame = FALSE, main.title.position="center")+
tm_legend(outside="FALSE", frame.lwd=2.0, bg.color="white",text.size= 0.75)
# display the layer
popgrowth_map
########################################
## part 2 small multiples
# Map population growth
popgrowth_map <- tm_shape(world_rob_join) +
tm_fill("pop_growth", palette = "Reds", style='quantile', n=5, alpha = 0.75, title='Pop. Growth') +
tm_borders(col='grey',lwd = 1)+
tm_layout(main.title = "World Population Growth", frame = FALSE, main.title.position="center")+
tm_legend(outside="FALSE", frame.lwd=2.0, bg.color="white",text.size= 0.5)
# display the layer
popgrowth_map
# Map gdpPercap
gdp_map <- tm_shape(world_rob_join) +
tm_fill("gdpPercap", palette = "Reds", style='quantile', n=5, alpha = 0.75, title='GDP per Cap') +
tm_borders(col='grey',lwd = 1)+
tm_layout(main.title = "World GDP per Capita", frame = FALSE, main.title.position="center")+
tm_legend(outside="FALSE", frame.lwd=2.0, bg.color="white",text.size= 0.5)
# display the layer
gdp_map
# Map life expectancy
life_map <- tm_shape(world_rob_join) +
tm_fill("lifeExp", palette = "Reds", style='quantile', n=5, alpha = 0.75, title='Life expectancy') +
tm_borders(col='grey',lwd = 1)+
tm_layout(main.title = "World Life Expectancy", frame = FALSE, main.title.position="center")+
tm_legend(outside="FALSE", frame.lwd=2.0, bg.color="white",text.size= 0.5)
# display the layer
life_map
# Map unemployment
unemploy_map <- tm_shape(world_rob_join) +
tm_fill("unemployment", palette = "Reds", style='quantile', n=5, alpha = 0.75, title='Unemployment') +
tm_borders(col='grey',lwd = 1)+
tm_layout(main.title = "World Unemployment", frame = FALSE, main.title.position="center")+
tm_legend(outside="FALSE", frame.lwd=2.0, bg.color="white",text.size= 0.5)
# display the layer
unemploy_map
# plot the maps in 2 x 2 arrangement
tmap_arrange(popgrowth_map, gdp_map,life_map, unemploy_map, ncol=2, nrow=2)
########################################
## part 3 scatter plot
# this was learned in Lab 1
plot(world_rob_join$lifeExp, world_rob_join$pop_growth,
main = "Life Expectancy and Population Growth",
xlab = "Life Expectancy",
ylab = "Population Growth",
col = "blue")
# note Y in lm needs to come first
lm <- lm(world_rob_join$pop_growth~world_rob_join$lifeExp)
abline(lm, col = "red")
